# Copy to .env and fill in. .env is gitignored.
#
# Only PUBLIC_* variables reach the browser. Everything else stays server-side:
# the service role key bypasses every RLS policy, and the access token can
# reconfigure the whole project.

# --- Public: shipped to the browser, protected by RLS ---
PUBLIC_SUPABASE_URL=https://budbfhrqdeghyufeizpv.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_SITE_URL=https://prems.getmira.run
# Optional. Defaults to the deployed service in src/lib/prems/ocr.js.
PUBLIC_PREMS_API_URL=

# --- Private: provisioning and workers only, never bundled ---
SUPABASE_PROJECT_REF=budbfhrqdeghyufeizpv
SUPABASE_ACCESS_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Cloud (workers) ---
# Authentication is Application Default Credentials. On Cloud Run the container
# already has an identity and both of these stay empty; locally, run
# `gcloud auth application-default login` or set one of them.
#
# GOOGLE_APPLICATION_CREDENTIALS is a *path* to a service-account key file.
# GCP_SERVICE_ACCOUNT_JSON is the key file's *contents*, for the case where all
# you can set is an environment variable — a CI runner, a hosted agent. The
# tools write it to a 0600 file outside the repository and point ADC at it.
# Never commit either one.
GOOGLE_APPLICATION_CREDENTIALS=
GCP_SERVICE_ACCOUNT_JSON=
GCP_PROJECT_ID=gen-lang-client-0781599139
# Where the jobs and the embedding model live.
GCP_REGION=europe-west9
# The agent model, and where it is served from. These two are one decision:
# `npm run gcp:models` probes every pair and tells you which ones answer.
#
#   gemini-3.7-flash @ global        — the default. No EU data residency: the
#                                      global endpoint processes anywhere.
#   gemini-3.5-flash @ europe-west3  — Frankfurt, the only European region that
#                                      serves a 3.x model. Set both to fall back.
#   gemini-2.5-flash @ europe-west9  — Paris, alongside the jobs themselves.
#
# Leave both empty to take the default pair from workers/src/agent.ts.
GCP_MODEL=
GCP_MODEL_LOCATION=

# --- Stripe ---
# A payment link is public by design, so the live URLs are the defaults in
# src/lib/prems/billing.js and nothing has to be set here. These exist only to
# point the same UI at another account - a sandbox, or a fork.
PUBLIC_STRIPE_LINK_SOLDAT=
PUBLIC_STRIPE_LINK_FONDATEUR=
PUBLIC_STRIPE_LINK_COMMANDO=
PUBLIC_STRIPE_LINK_INVESTISSEUR=

# Customer portal login page, from Stripe > Settings > Billing > Customer
# portal. Empty = the Abonnement section says the portal is not open yet
# rather than linking to an error page.
PUBLIC_STRIPE_PORTAL_URL=

# Signing secret of the Prems webhook endpoint (whsec_…). Server only: it is
# what proves a webhook call came from Stripe and not from someone who read the
# URL. Held as a Supabase Function secret, never here in a real .env.
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
