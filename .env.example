# Copy to .env and fill in. .env is gitignored.
#
# Only PUBLIC_* variables reach the browser. Everything else stays server-side:
# the service role key bypasses every RLS policy, and the access token can
# reconfigure the whole project.

# --- Public: shipped to the browser, protected by RLS ---
PUBLIC_SUPABASE_URL=https://budbfhrqdeghyufeizpv.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_SITE_URL=https://prems.getmira.run
# Optional. Defaults to the deployed service in src/lib/prems/ocr.js.
PUBLIC_PREMS_API_URL=

# --- Private: provisioning and workers only, never bundled ---
SUPABASE_PROJECT_REF=budbfhrqdeghyufeizpv
SUPABASE_ACCESS_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=

# --- Amazon Bedrock (the agents) ---
# The three agents run on the Strands Agents SDK with Claude on Amazon Bedrock.
# Credentials follow the AWS SDK default chain: an IAM role where one is
# attached, otherwise these two keys (held in Secret Manager for Cloud Run,
# never committed). The IAM principal needs bedrock:InvokeModel and
# bedrock:InvokeModelWithResponseStream, and Anthropic model access enabled.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Where Bedrock is called from. Paris by default.
AWS_REGION=eu-west-3
# The model. `eu.` keeps inference in European regions; `npm run bedrock:models`
# runs one real turn per candidate ID and tells you which ones answer.
# Leave empty for the default in workers/src/agent.ts (eu.anthropic.claude-opus-5).
BEDROCK_MODEL_ID=

# --- Google Cloud (embeddings and scheduling only) ---
# Cloud Run Jobs host the workers; Vertex AI serves the 768-dimension embedding
# model the catalogue was built with. No agent turn goes to Google Cloud.
# Authentication is Application Default Credentials: on Cloud Run both of these
# stay empty; locally run `gcloud auth application-default login` or set one.
GOOGLE_APPLICATION_CREDENTIALS=
GCP_SERVICE_ACCOUNT_JSON=
GCP_PROJECT_ID=gen-lang-client-0781599139
# Where the jobs and the embedding model live.
GCP_REGION=europe-west9

# --- Workers ---
SUPABASE_URL=https://budbfhrqdeghyufeizpv.supabase.co
COMPOSIO_API_KEY=

# --- Paiements ---
# Coupés par défaut : l'écran des tarifs reste affiché, mais le clic ouvre
# l'accès sur place au lieu d'envoyer chez Stripe. Rien dans le pipeline n'est
# conditionné à l'abonnement, donc l'agent fonctionne à l'identique.
# Mettre `true` pour rouvrir l'encaissement — liens, portail et webhook n'ont
# pas bougé et reprennent tels quels.
PUBLIC_PAYMENTS_ENABLED=

# --- Stripe ---
# A payment link is public by design, so the live URLs are the defaults in
# src/lib/prems/billing.js and nothing has to be set here. These exist only to
# point the same UI at another account - a sandbox, or a fork.
PUBLIC_STRIPE_LINK_SOLDAT=
PUBLIC_STRIPE_LINK_FONDATEUR=
PUBLIC_STRIPE_LINK_COMMANDO=
PUBLIC_STRIPE_LINK_INVESTISSEUR=

# Customer portal login page, from Stripe > Settings > Billing > Customer
# portal. Empty = the Abonnement section says the portal is not open yet
# rather than linking to an error page.
PUBLIC_STRIPE_PORTAL_URL=

# Signing secret of the Prems webhook endpoint (whsec_…). Server only: it is
# what proves a webhook call came from Stripe and not from someone who read the
# URL. Held as a Supabase Function secret, never here in a real .env.
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
