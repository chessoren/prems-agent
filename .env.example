# Copy to .env and fill in. .env is gitignored.
#
# Only PUBLIC_* variables reach the browser. Everything else stays server-side:
# the service role key bypasses every RLS policy, and the access token can
# reconfigure the whole project.

# --- Public: shipped to the browser, protected by RLS ---
PUBLIC_SUPABASE_URL=https://budbfhrqdeghyufeizpv.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
# Production origin. Feeds the Supabase redirect allow-list on db:provision.
PUBLIC_SITE_URL=https://prems.getmira.run

# --- Private: provisioning only, never bundled ---
SUPABASE_PROJECT_REF=budbfhrqdeghyufeizpv
SUPABASE_ACCESS_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloud Run (P1: OCR shortcuts). Absent = shortcuts hidden, manual entry unaffected. ---
PUBLIC_PREMS_API_URL=

# --- Stripe ---
# A payment link is public by design, so the live URLs are the defaults in
# src/lib/prems/billing.js and nothing has to be set here. These exist only to
# point the same UI at another account - a sandbox, or a fork.
PUBLIC_STRIPE_LINK_SOLDAT=
PUBLIC_STRIPE_LINK_FONDATEUR=
PUBLIC_STRIPE_LINK_COMMANDO=
PUBLIC_STRIPE_LINK_INVESTISSEUR=

# Customer portal login page, from Stripe > Settings > Billing > Customer
# portal. Empty = the Abonnement section says the portal is not open yet
# rather than linking to an error page.
PUBLIC_STRIPE_PORTAL_URL=
