---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/policy-privacy-policy/Nav.astro';
import Footer from '../../components/policy-privacy-policy/Footer.astro';
import Policy from '../../components/policy-privacy-policy/Policy.astro';

// Plain stylesheets, linked in this exact order. They deliberately do not
// go through the bundler: Vite merges large sibling stylesheets into shared
// chunks, which reorders the cascade and can attach the wrong file to a
// page. Editing public/styles/*.css edits the real thing.
const styles = ["/styles/fonts.css","/styles/tokens.css","/styles/policy-privacy-policy.css","/styles/runtime.css"];
const meta = {
  "title": "Privacy Policy | Our Privacy Policy",
  "description": "Our Privacy Policy outlines how we collect, use, and protect your personal information. Your privacy and security are our priorities.",
  "ogTitle": "Privacy Policy | Our Privacy Policy",
  "ogDescription": "Our Privacy Policy outlines how we collect, use, and protect your personal information. Your privacy and security are our priorities.",
  "ogImage": "https://framerusercontent.com/assets/uzMeQ7lVwm8G1emfR8yV4Fp4.png",
  "canonical": "https://prems.framer.ai/policy/privacy-policy",
  "lang": "fr-FR"
};
const appear = null;
---

