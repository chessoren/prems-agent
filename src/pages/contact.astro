---
import Base from '../layouts/Base.astro';
import Nav from '../components/contact/Nav.astro';
import Footer from '../components/contact/Footer.astro';
import Hero from '../components/contact/Hero.astro';

// Plain stylesheets, linked in this exact order. They deliberately do not
// go through the bundler: Vite merges large sibling stylesheets into shared
// chunks, which reorders the cascade and can attach the wrong file to a
// page. Editing public/styles/*.css edits the real thing.
const styles = ["/styles/fonts.css","/styles/tokens.css","/styles/contact.css","/styles/runtime.css"];
const meta = {
  "title": "Contact Us | Get in Touch with Us",
  "description": "Reach out to us for inquiries, support, or partnership opportunities. We're here to assist you!",
  "ogTitle": "Contact Us | Get in Touch with Us",
  "ogDescription": "Reach out to us for inquiries, support, or partnership opportunities. We're here to assist you!",
  "ogImage": "https://framerusercontent.com/assets/uzMeQ7lVwm8G1emfR8yV4Fp4.png",
  "canonical": "https://prems.framer.ai/contact",
  "lang": "fr-FR"
};
const appear = null;
---

