---
/**
 * Shared document shell for every page.
 *
 * Holds the <head>, the global stylesheets, and the tiny runtime that replaces
 * Framer's React bundle. Page-specific styles are imported by the page itself.
 */
// Stylesheets are imported by each page, in an explicit order, so that the
// cascade matches the original document exactly.

interface Meta {
  title: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  canonical?: string;
  lang?: string;
}

interface Props {
  meta: Meta;
  appear?: unknown;
  /** Stylesheet hrefs, applied in order. */
  styles?: string[];
}

const { meta, appear = null, styles = [] } = Astro.props;
const lang = meta.lang || 'fr';

/**
 * The origin this site is actually served from.
 *
 * Every page came out of the export declaring https://prems.framer.ai as its
 * canonical. Left alone, the production site would tell search engines that the
 * Framer original is the real version of every page - which is the fastest way
 * to not get indexed at all. The canonical is therefore derived from the page's
 * own path against the deployed origin, not copied from the export.
 */
const SITE = import.meta.env.PUBLIC_SITE_URL || Astro.site?.href || '';

const canonical = SITE ? new URL(Astro.url.pathname, SITE).href : meta.canonical;

/**
 * The social preview card, drawn by tools/make-og-image.mjs.
 *
 * The exported og:image came from the Framer template and showed a different
 * product - an email SaaS dashboard - so every Prems link shared anywhere
 * carried a screenshot of someone else's app. It also lived on
 * framerusercontent.com and weighed 7.3 MB, past the point where X drops the
 * card entirely. Pages may still override it; nothing does today.
 */
const ogImagePath = meta.ogImage?.startsWith('/') ? meta.ogImage : '/assets/og/prems.jpg';
const ogImage = SITE ? new URL(ogImagePath, SITE).href : ogImagePath;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    {meta.description && <meta name="description" content={meta.description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {meta.ogTitle && <meta property="og:title" content={meta.ogTitle} />}
    {meta.ogDescription && <meta property="og:description" content={meta.ogDescription} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content="Astro" />
    {styles.map((href) => <link rel="stylesheet" href={href} />)}
  </head>
  <body>
    <div id="main">
      <slot />
    </div>

    {
      appear && (
        <script type="application/json" id="appear-data" set:html={JSON.stringify(appear)} />
      )
    }

    <script>
      import { initAppear } from '../scripts/appear.js';
      import { initInteractions } from '../scripts/interactions.js';

      const node = document.getElementById('appear-data');
      if (node) {
        try {
          initAppear(JSON.parse(node.textContent || '{}'));
        } catch {
          /* malformed payload - leave elements in their final state */
        }
      }
      initInteractions();
    </script>
  </body>
</html>
